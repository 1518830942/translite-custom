{
  "name": "translite",
  "version": "1.2.0",
  "description": "Translite Custom - 选中文字，一键翻译与英美音标",
  "author": "1518830942",
  "license": "MIT",
  "repository": "https://github.com/1518830942/translite-custom.git",
  "packageManager": "pnpm@11.19.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-selection.cjs && electron-vite dev",
    "build:selection": "node scripts/build-selection.cjs",
    "start": "electron-vite preview",
    "build:win": "node scripts/build-selection.cjs && electron-vite build && electron-builder --win --publish never",
    "build:mac": "node scripts/build-selection.cjs && electron-vite build && electron-builder --mac --arm64 --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web"
  },
  "dependencies": {
    "electron-store": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
